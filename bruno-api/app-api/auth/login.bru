meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "user@test2.com",
    "password": "11111"
  }
}

script:post-response {
  const response = res.getBody();
  
  // Ambil token dari response
  const token = response.data.token;
  
  // Simpan token ke environment
  bru.setEnvVar("token", token);
  
}

settings {
  encodeUrl: true
  timeout: 0
}
